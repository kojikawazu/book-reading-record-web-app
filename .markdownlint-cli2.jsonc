// markdownlint の設定。運用方針は .claude/rules/static-analysis.md に従う。
//
// 方針: 見た目（行長・表のパイプ揃え・強調記号の種類）に関するルールは有効にしない。
// Formatter を持たない Markdown でこれらを error にすると、内容と無関係な指摘が
// 常時出続けて警告が常態化し、検出装置として機能しなくなるため。
// 有効に残すのは「壊れている・読み手が実害を受ける」もの（リンク切れの温床・見出し
// 階層の飛び・コードブロックの言語指定漏れ等）に限る。
{
  "globs": ["**/*.md"],
  "ignores": [
    "front/node_modules",
    // Google AI Studio から取り込んだ参照用の生成物。本体の規約対象外。
    "base"
  ],
  "config": {
    "default": true,

    // --- 見た目のため無効化するもの ---------------------------------------
    // MD013: 行長制限。日本語の説明文と表を 80 桁に収める意味がない。
    "MD013": false,
    // MD060: 表のパイプ前後のスペース揃え。純粋な見た目。
    "MD060": false,
    // MD033: インライン HTML。<br> や <details> を意図的に使う。
    "MD033": false,
    // MD034: 裸の URL。localhost 等をそのまま書く方が読みやすい箇所がある。
    "MD034": false,

    // --- 構造上わざと外すもの ---------------------------------------------
    // MD024: 同名見出しの重複。仕様書で「## 概要」が節ごとに出るのは正常。
    "MD024": false,
    // MD041: 先頭行が h1 であること。frontmatter 付きのルールファイルが該当しない。
    "MD041": false
  }
}
