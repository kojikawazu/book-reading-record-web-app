# Supabase client (browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Optional (if your project uses publishable key naming)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# NOTE:
# - This app does NOT use GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET in .env.local.
# - Google OAuth provider credentials are managed on the Supabase Auth project side.
NEXT_PUBLIC_REPOSITORY_DRIVER="supabase"
# Supabase Auth redirect URL example:
# http://localhost:3000/auth/login

# Supabase + Prisma (server / CLI)
# NOTE: This repository syncs schema by pull. Do not run push here.
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=public"

# 更新系 API（POST / PATCH / DELETE）を許可する唯一のメールアドレス（サーバー専用・NEXT_PUBLIC_ を付けない）。
# Supabase Auth でログインしたユーザーのメールと一致しなければ 403。未設定なら更新系はすべて 500 で拒否する。
ADMIN_EMAIL="you@example.com"

# Optional server-side key (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Tests (IT / E2E) -------------------------------------------------------
# テスト用 DB の接続先。本番用の DATABASE_URL とは別名にする（.claude/rules/testing.md）。
# 未設定なら docker-compose.test.yml の使い捨てコンテナ（下記の既定値）が使われる。
# ホストは localhost / 127.0.0.1 / ::1 のみ許可され、それ以外は実行前に throw する。
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/book_record_test?schema=public"
